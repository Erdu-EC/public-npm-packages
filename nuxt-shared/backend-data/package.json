{
  "name": "@erdu-ec/nuxt-backend-data",
  "version": "1.1.1",
  "description": "Reusable typed backend data and fetch composables layer for Nuxt applications",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "nuxt4",
    "fetch",
    "api",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./composables": {
      "types": "./dist/runtime/composables/index.d.ts",
      "import": "./dist/runtime/composables/index.js"
    },
    "./types": {
      "types": "./dist/runtime/types/index.d.ts",
      "import": "./dist/runtime/types/index.js"
    },
    "./utils": {
      "types": "./dist/runtime/utils/index.d.ts",
      "import": "./dist/runtime/utils/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Erdu-EC/public-npm-packages.git",
    "directory": "nuxt-shared/backend-data"
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "dev:prepare": "nuxt prepare",
    "prepare": "nuxt prepare",
    "prepack": "nuxt-module-build build",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "^4.0.0",
    "defu": "^6.1.4"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0",
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@nuxt/kit": "^4.6.2",
    "@nuxt/module-builder": "^1.0.3",
    "@types/node": "^22.13.0",
    "nuxt": "^4.6.2",
    "typescript": "^5.9.3",
    "vue": "^3.5.13",
    "vue-tsc": "^3.3.13"
  }
}
